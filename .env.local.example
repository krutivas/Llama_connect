# Database
DATABASE_URL="file:./dev.db"

# Stripe Keys (get from https://dashboard.stripe.com/test/apikeys)
# Make sure you're in TEST MODE (not live mode)
STRIPE_SECRET_KEY="sk_test_YOUR_SECRET_KEY_HERE"
STRIPE_PUBLISHABLE_KEY="pk_test_YOUR_PUBLISHABLE_KEY_HERE"

# Stripe Webhook Secret (get from `stripe listen` command)
# Run: stripe listen --events checkout.session.completed,customer.subscription.updated,customer.subscription.deleted --forward-to localhost:3000/api/stripe/webhook
# Copy the whsec_... secret that gets printed
STRIPE_WEBHOOK_SECRET="whsec_YOUR_WEBHOOK_SECRET_HERE"

# Stripe Price IDs (create in Stripe Dashboard -> Products -> Add Product)
# Create two products with recurring prices:
# 1. Monthly subscription: $9.99/month
# 2. Annual subscription: $99/year
# Then paste the price IDs here (they start with "price_")
STRIPE_PRICE_MONTHLY="price_YOUR_MONTHLY_PRICE_ID"
STRIPE_PRICE_ANNUAL="price_YOUR_ANNUAL_PRICE_ID"

# App URL
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
